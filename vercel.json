{
  "version": 2,
  "builds": [
    {
      "src": "admin/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://linkadda-tg-bot.onrender.com/api/$1"
    },
    {
      "source": "/l/(.*)",
      "destination": "https://linkadda-tg-bot.onrender.com/l/$1"
    },
    {
      "source": "/login",
      "destination": "/admin/login.html"
    },
    {
      "source": "/(.*)",
      "destination": "/admin/$1"
    }
  ]
}
