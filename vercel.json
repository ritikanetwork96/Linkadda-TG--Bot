{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "admin/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://linkadda-tg-bot.onrender.com/api/:path*"
    },
    {
      "source": "/l/:path*",
      "destination": "https://linkadda-tg-bot.onrender.com/l/:path*"
    },
    {
      "source": "/login",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/:path*"
    },
    {
      "source": "/((?!api|l|admin).*)",
      "destination": "/admin/$1"
    }
  ]
}
