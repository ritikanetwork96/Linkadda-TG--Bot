{
  "version": 2,
  "outputDirectory": "admin",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://linkadda-tg-bot.onrender.com/api/$1"
    },
    {
      "src": "/l/(.*)",
      "dest": "https://linkadda-tg-bot.onrender.com/l/$1"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
