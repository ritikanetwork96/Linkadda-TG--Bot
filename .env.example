# Environment configuration template for Telegram Bot Platform

NODE_ENV=development
PORT=3000

# Telegram Bot configuration (Public User Bot)
USER_BOT_TOKEN=your_telegram_bot_token_from_botfather
USER_BOT_USERNAME=your_telegram_bot_username

# Telegram Bot configuration (Private Admin Bot - Optional)
ADMIN_BOT_TOKEN=your_admin_bot_token_from_botfather
ADMIN_BOT_USERNAME=your_admin_bot_username
ADMIN_TELEGRAM_IDS=123456789,987654321

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB_NAME=Linkadda-bot

# Filebase S3 Configuration
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_REGION=auto
FILEBASE_ACCESS_KEY=your_filebase_access_key
FILEBASE_SECRET_KEY=your_filebase_secret_key
FILEBASE_BUCKET=your_filebase_bucket_name

# Administrative Security
ADMIN_JWT_SECRET=your_jwt_signing_secret_key
ADMIN_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@bot.com
ADMIN_PASSWORD=adminpassword

# Configurable Media Upload Limit
MAX_FILE_SIZE_MB=20

